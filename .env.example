# Copier dans .env, remplir localement ; ne jamais publier .env.
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=mercasport
DB_USER=postgres
DB_PASSWORD=
PORT=3000

# Alternative pour PostgreSQL hébergé (prioritaire sur DB_*).
# Utiliser l’URL du fournisseur, avec ses paramètres TLS, sans désactiver les certificats.
# DATABASE_URL=postgresql://utilisateur:mot-de-passe@serveur:5432/mercasport?sslmode=verify-full
